#!/usr/bin/env ruby

require 'date'

# I hate these little scripts :(

unless ARGV.length == 1
	fail "Usage: #{$0} path/to/capstone/python/capstone"
end

prefix = <<END
/*
Gapstone is a Go binding for the Capstone disassembly library. For examples,
try reading the *_test.go files.

	Library Author: Nguyen Anh Quynh
	Binding Author: Ben Nagy
	License: BSD style - see LICENSE file for details
    (c) 2013 COSEINC. All Rights Reserved.

    THIS FILE WAS AUTO-GENERATED -- DO NOT EDIT!
	Command: #{$0} #{ARGV[0]}
	#{DateTime.now}

*/

package gapstone

// #cgo LDFLAGS: -lcapstone
// #cgo freebsd CFLAGS: -I/usr/local/include
// #cgo freebsd LDFLAGS: -L/usr/local/lib
// #include <stdlib.h>
// #include <capstone/capstone.h>
import "C"

END

pyfiles = Dir.glob(File.join(ARGV[0], "*_const.py"))
if pyfiles.empty?
	fail "No *_const.py files found in #{ARGV[0]}"
end

def strip_inline_comment(value)
	in_single = false
	in_double = false
	escaped = false
	value.each_char.with_index do |ch, idx|
		if escaped
			escaped = false
			next
		end

		if ch == '\\'
			escaped = true
			next
		end

		if ch == "'" && !in_double
			in_single = !in_single
			next
		end

		if ch == '"' && !in_single
			in_double = !in_double
			next
		end

		if ch == '#' && !in_single && !in_double
			return value[0...idx].rstrip
		end
	end

	value.rstrip
end

pyfiles.each {|pyfn|

	gofn = "#{File.basename(pyfn).split('_').first}_constants.go"
	source_pyfn = pyfn
	rename_rules = []

	case File.basename(pyfn)
	when 'arm64_const.py'
		source_pyfn = File.join(File.dirname(pyfn), 'aarch64_const.py')
		rename_rules = [['AARCH64', 'ARM64'], ['AArch64CC', 'ARM64_CC']]
	when 'sysz_const.py'
		source_pyfn = File.join(File.dirname(pyfn), 'systemz_const.py')
		rename_rules = [['SYSTEMZ', 'SYSZ']]
	end

	generated = String.new(prefix)
	clumping = false
	const_count = 0
	seen = {}

	File.foreach(source_pyfn) {|l|
		# if line starts with 'import' or 'from . import', skip it
		next if l =~ /^import|^from \./
		case l
		when /^#|^$/
			# close any clump
			generated << ")\n\n" if clumping
			clumping = false
			if l =~ /^#/
				# Emit a go-style comment
				generated << "#{l.sub('#', %q(//))}"
			end
		when /^([A-Za-z][A-Za-z0-9_]*)\s*=\s*(.+)$/
			const = $1
			value = strip_inline_comment($2.strip)
			rename_rules.each do |from, to|
				const = const.gsub(from, to)
				value = value.gsub(from, to)
			end
			next if value.empty?
			if value.start_with?('{', '[')
				generated << ")\n\n" if clumping
				clumping = false
				next
			end
			if seen[const]
				next
			end
			seen[const] = true
			generated << "const (\n" unless clumping
			clumping = true
			generated << "\t#{const} = #{value}\n"
			const_count += 1
		else
			generated << ")\n\n" if clumping
			clumping = false
		end
	}

	generated << ")\n\n" if clumping

	if const_count == 0
		warn "Skipping #{pyfn}: no direct constants found"
		next
	end

	File.open(gofn, 'w+') {|gofh| gofh.write(generated) }

	# if all is well, this will nicely format all the files we just wrote. <3
	`go fmt #{gofn}`
}
